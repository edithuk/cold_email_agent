# ──────────────────────────────────────────────────────────────────
# Cold Email Agent – Frontend Environment Example
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and will never be committed.
#
# Usage:
#   cp frontend/.env.example frontend/.env.local
# ──────────────────────────────────────────────────────────────────

# ── Firebase project config ────────────────────────────────────────
# Find these at: Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── Local vs Production ────────────────────────────────────────────
# Set to 'true' to route all Firebase traffic through local emulators.
# Set to 'false' (or remove) to connect directly to production Firebase.
# Run emulators with: firebase emulators:start --only auth,functions,firestore,pubsub
VITE_USE_EMULATOR=true

# ── Client-side encryption salt ───────────────────────────────────
# Used to derive the AES-GCM key for encrypting SMTP passwords in the browser.
# MUST match the ENCRYPTION_SALT secret set in Firebase Functions.
# Use any long random string. Changing this will invalidate saved credentials.
VITE_ENCRYPTION_SALT=change_me_to_a_long_random_string

# ── AI Copilot ─────────────────────────────────────────────────────
# Provider: 'gemini' or 'groq'
VITE_AI_PROVIDER=groq

# Google Gemini — get a key at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_GEMINI_MODEL=gemini-2.0-flash

# Groq — get a key at https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key
VITE_GROQ_MODEL=llama-3.3-70b-versatile
