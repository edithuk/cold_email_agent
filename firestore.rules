rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User-scoped data ──────────────────────────────────────────────────
    // Only the authenticated user can read/write their own data.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Public templates ──────────────────────────────────────────────────
    // Any authenticated user can READ public templates.
    // Only the owner (stored in ownerId field) can WRITE.
    match /users/{userId}/templates/{templateId} {
      allow read: if request.auth != null &&
                  (request.auth.uid == userId || resource.data.isPublic == true);
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
