rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User-scoped data ────────────────────────────────────────────────────
    // Only the authenticated user can read/write their own profile, credentials,
    // templates, and scheduled_jobs.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Scheduled Jobs – collectionGroup read for Cloud Functions ───────────
    // Firebase Admin SDK (used by Cloud Functions) bypasses security rules
    // entirely, so no special rule is needed for the backend.
    // This rule allows a signed-in user to query their own jobs only.
    match /users/{userId}/scheduled_jobs/{jobId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
